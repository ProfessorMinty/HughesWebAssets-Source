{
  "name": "hughes-web-assets-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:hub": "node tools/build-classroom-explorations-hub.mjs && vite --config vite.hub.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "build:hub": "node tools/build-classroom-explorations-hub.mjs && tsc --noEmit && vite build --config vite.hub.config.ts",
    "stage:photo-album-release": "node tools/stage-photo-album-release.mjs 2026.08.10.1",
    "stage:hub-release": "node tools/stage-classroom-explorations-hub-release.mjs",
    "preview": "vite preview --config vite.config.ts",
    "preview:hub": "vite preview --config vite.hub.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "check:hub": "npm run test && npm run build:hub"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
