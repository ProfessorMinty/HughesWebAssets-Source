{
  "name": "hughes-web-assets-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "build:hub:content": "node tools/build-classroom-explorations-hub-content.mjs",
    "build:hub:runtime": "node tools/build-classroom-explorations-hub-runtime.mjs",
    "build:hub:preview": "node tools/build-classroom-explorations-hub-preview.mjs",
    "build:hub": "npm run build:hub:content && npm run build:hub:runtime && npm run build:hub:preview && node tools/verify-classroom-explorations-hub.mjs",
    "stage:photo-album-release": "node tools/stage-photo-album-release.mjs 2026.08.10.5",
    "stage:hub-publication": "node tools/stage-classroom-explorations-hub-publication.mjs",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hub": "node tools/test-classroom-explorations-hub-v2.mjs && node tools/test-classroom-explorations-hub-visual-v3.mjs && node tools/test-classroom-explorations-hub-host-compat.mjs",
    "check": "npm run test && npm run build",
    "check:hub": "npm run test:hub && npm run build:hub && npm run test:hub:publication",
    "test:hub:publication": "node tools/test-classroom-explorations-hub-publication.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
