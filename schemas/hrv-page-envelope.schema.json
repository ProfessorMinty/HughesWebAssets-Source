{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hughes-room-views.invalid/schemas/hrv-page-envelope.schema.json",
  "title": "Hughes Room Views repository-owned page source envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "page", "data"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "routeRef"],
      "properties": {
        "id": { "type": "string", "pattern": "^hrv-page:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "routeRef": { "type": "string", "pattern": "^hrv-route:[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "data": { "type": "object" }
  }
}
