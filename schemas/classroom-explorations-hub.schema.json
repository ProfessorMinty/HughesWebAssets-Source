{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hughes-room-views.invalid/schemas/classroom-explorations-hub.schema.json",
  "title": "Hughes Room Views Classroom Explorations Hub Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "page", "schoolYears", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "contentVersion": { "type": "string", "minLength": 1 },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "routeUrl", "currentSchoolYear", "theme", "museum"],
      "properties": {
        "id": { "const": "classroom-explorations-hub" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "routeUrl": { "type": "string", "format": "uri", "pattern": "^https://rmhughes\\.edublogs\\.org/classroom-explorations/?$" },
        "currentSchoolYear": { "$ref": "#/$defs/schoolYearId" },
        "theme": { "$ref": "#/$defs/stableId" },
        "museum": { "$ref": "#/$defs/museum" }
      }
    },
    "schoolYears": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display", "status", "order"],
        "properties": {
          "id": { "$ref": "#/$defs/schoolYearId" },
          "display": { "type": "string", "pattern": "^[0-9]{4}–[0-9]{4}$" },
          "status": { "enum": ["current", "archived"] },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "schoolYearId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{4}$"
    },
    "nullableHttpsUrl": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "uri", "pattern": "^https://" }
      ]
    },
    "museum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kicker", "pillars", "oathTitle", "oath", "footer", "dividerImageUrl"],
      "properties": {
        "kicker": { "type": "string", "minLength": 1 },
        "pillars": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "oathTitle": { "type": "string", "minLength": 1 },
        "oath": { "type": "string", "minLength": 1 },
        "footer": { "type": "string", "minLength": 1 },
        "dividerImageUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sectionKicker": { "type": "string", "minLength": 1 },
        "slotLabel": { "type": "string", "minLength": 1 },
        "visualBadge": { "type": "string", "minLength": 1 },
        "actionLabel": { "type": "string", "minLength": 1 },
        "statusLabel": { "type": "string", "minLength": 1 }
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "published": { "type": "string", "format": "date" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "schoolYear", "title", "summary", "pageUrl", "imageUrl", "imageAlt", "emoji", "theme", "animation", "order", "dates", "completeness"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": { "enum": ["exploration", "twwl", "archive-doorway", "video"] },
        "status": { "enum": ["current", "past", "archived", "coming-soon"] },
        "schoolYear": { "$ref": "#/$defs/schoolYearId" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "pageUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
        "imageUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
        "imageAlt": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "emoji": { "type": "string", "minLength": 1 },
        "theme": { "$ref": "#/$defs/stableId" },
        "animation": { "$ref": "#/$defs/stableId" },
        "order": { "type": "integer", "minimum": 0 },
        "dates": { "$ref": "#/$defs/dates" },
        "learningPoints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "presentation": { "$ref": "#/$defs/presentation" },
        "archiveSchoolYear": { "$ref": "#/$defs/schoolYearId" },
        "completeness": { "enum": ["complete", "incomplete", "not-applicable"] },
        "notice": { "type": "string", "minLength": 1 },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceUrl"],
          "properties": {
            "kind": { "const": "youtube" },
            "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://(?:www\\.)?(?:youtube\\.com|youtu\\.be)/" },
            "embedUrl": { "type": "string", "format": "uri", "pattern": "^https://www\\.youtube-nocookie\\.com/embed/" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "coming-soon" } }, "required": ["status"] },
          "then": { "properties": { "pageUrl": { "type": "null" } } }
        },
        {
          "if": { "properties": { "type": { "const": "archive-doorway" } }, "required": ["type"] },
          "then": { "required": ["archiveSchoolYear"] }
        },
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": { "required": ["media"] }
        },
        {
          "if": { "properties": { "completeness": { "const": "incomplete" } }, "required": ["completeness"] },
          "then": { "required": ["notice"] }
        }
      ]
    }
  }
}
